# Local development settings; Docker Compose and Python both read .env.
POSTGRES_DB=coffee
POSTGRES_USER=coffee
POSTGRES_PASSWORD=coffee_local_dev
POSTGRES_PORT=5433
DATABASE_URL=postgresql://coffee:coffee_local_dev@localhost:5433/coffee
OVERPASS_URL=https://overpass.private.coffee/api/interpreter
# Hosted walking/driving routes. Obtain a key at https://openrouteservice.org/dev/
# Keep this key on the Python server; never put it in browser JavaScript.
ORS_API_KEY=
